; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Car Crash Simulator"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameContext="*res://scripts/autoload/GameContext.gd"
TimeScale="*res://scripts/autoload/TimeScale.gd"
InputRouter="*res://scripts/autoload/InputRouter.gd"
Settings="*res://scripts/autoload/Settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas"

[physics]

3d/default_linear_damp=0.0

[rendering]

; Движок по умолчанию — Compatibility (OpenGL), а не Vulkan Forward+: на встроенных
; GPU он почти вдвое дешевле (замерено на Intel HD 630 при 1600×900: 9.3 мс против
; 18.6 мс на одном и том же содержимом) и не упирается в бюджет вертикалки 60 Гц.
; Тот же движок использует web-сборка, поэтому картинка везде одинаковая.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
