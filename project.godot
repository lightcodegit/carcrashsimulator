; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Car Crash Simulator"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameContext="*res://scripts/autoload/GameContext.gd"
TimeScale="*res://scripts/autoload/TimeScale.gd"
InputRouter="*res://scripts/autoload/InputRouter.gd"
Settings="*res://scripts/autoload/Settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
; HUD и меню разложены в координатах 1600×900. Без растяжения окно меньшего размера
; обрезало бы правую панель журнала, а большого — оставило бы её висеть в середине
; экрана, поэтому интерфейс масштабируется целиком с сохранением пропорций.
window/stretch/mode="canvas"
window/stretch/aspect="keep"

[physics]

3d/default_linear_damp=0.0

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/screen_space_aa=1
